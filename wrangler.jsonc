{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lab-extraction-poc",
  "main": "src/server.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_BASE": "https://api.cloudraker.com",
    "CATALOG_URL": "https://catalog.cloudraker.com/catalog.json"
  },
  // Live runs per client IP address, for each Cloudflare location.
  "ratelimits": [{ "name": "RUN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true }
  // Secrets (wrangler secret put, or .dev.vars locally):
  //   PAPERWORK_API_KEY  required for live runs.
  //   DEMO_CODE          the code both run routes ask for. Without it, a deployed worker refuses live runs.
}
