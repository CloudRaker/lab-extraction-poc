{
  "name": "lab-extraction-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Classify and extract lab reports with the CloudRaker paperwork API.",
  "license": "MIT",
  "author": "CloudRaker",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && rm -f dist/server/.dev.vars dist/client/.dev.vars",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest --run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "run-samples": "tsx scripts/run-samples.ts",
    "lint": "oxlint src scripts --ignore-pattern 'src/components/arc/**' --ignore-pattern 'src/routeTree.gen.ts'"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "hono": "4.13.13",
    "lucide-react": "1.55.0",
    "motion": "14.9.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.48",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.87.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
